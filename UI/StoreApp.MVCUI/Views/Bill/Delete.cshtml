@model Bill

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Bill</h4>
    <hr />
    <div class="row">
        <div class="col-12">
            <div class="form-group">
                <label asp-for="BillNumber" class="control-label"></label>
                <div class="form-control-plaintext" style="width: 30%;">@Model.BillNumber</div>
            </div>
            <div class="form-group">
                <label asp-for="BillDate" class="control-label"></label>
                <div class="form-control-plaintext" style="width: 30%;">@Model.BillDate.ToString("yyyy-MM-dd")</div>
            </div>
            <div class="form-group">
                <label asp-for="PartyId" class="control-label"></label>
                <div class="form-control-plaintext" style="width: 30%;">@ViewBag.PartyName</div>
            </div>
            
            <div class="form-group">
                <h5>Bill Items</h5>
                <div class="table-responsive">
                    <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Item</th>
                            <th style="width: 15%; text-align: right;">Quantity</th>
                            <th style="width: 15%; text-align: right;">Price</th>
                            <th style="width: 15%; text-align: right;">Amount</th>
                            <th style="width: 15%;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.BillItems != null && Model.BillItems.Any())
                        {
                            @for (int i = 0; i < Model.BillItems.Count; i++)
                            {
                                <tr data-item-index="@i">
                                    <td style="width: 40%;">
                                        <div class="form-control-plaintext">@ViewBag.ItemNames[i]</div>
                                    </td>
                                    <td style="width: 15%; text-align: right;">
                                        <div class="form-control-plaintext">@Model.BillItems[i].Quantity</div>
                                    </td>
                                    <td style="width: 15%; text-align: right;">
                                        <div class="form-control-plaintext">@Model.BillItems[i].Price.ToString("F2")</div>
                                    </td>
                                    <td style="width: 15%; text-align: right;">
                                        <div class="form-control-plaintext">@Model.BillItems[i].Amount.ToString("F2")</div>
                                    </td>
                                    <td style="width: 15%;">
                                        <button type="button" class="btn btn-info btn-sm schedule-btn" data-item-index="@i">Schedule</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    </table>
                </div>
            </div>
            
            <div class="form-group" style="text-align: right; margin-right: 15%;">
                <label asp-for="ItemTotal" class="control-label"></label>
                <div class="form-control-plaintext" style="width: 30%; display: inline-block; text-align: right;">@Model.ItemTotal.ToString("F2")</div>
            </div>
            <div class="form-group" style="text-align: right; margin-right: 15%;">
                <label asp-for="Discount" class="control-label"></label>
                <div class="form-control-plaintext" style="width: 30%; display: inline-block; text-align: right;">@Model.Discount.ToString("F2")</div>
            </div>
            <div class="form-group" style="text-align: right; margin-right: 15%;">
                <label asp-for="NetAmount" class="control-label"></label>
                <div class="form-control-plaintext" style="width: 30%; display: inline-block; text-align: right;">@Model.NetAmount.ToString("F2")</div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="BillNumber" />
                <input type="hidden" asp-for="BillDate" />
                <input type="hidden" asp-for="PartyId" />
                <input type="hidden" asp-for="ItemTotal" />
                <input type="hidden" asp-for="Discount" />
                <input type="hidden" asp-for="NetAmount" />
                
                @if (Model.BillItems != null)
                {
                    @for (int i = 0; i < Model.BillItems.Count; i++)
                    {
                        <input type="hidden" name="BillItems[@i].Id" value="@Model.BillItems[i].Id" />
                        <input type="hidden" name="BillItems[@i].BillId" value="@Model.BillItems[i].BillId" />
                        <input type="hidden" name="BillItems[@i].ItemId" value="@Model.BillItems[i].ItemId" />
                        <input type="hidden" name="BillItems[@i].Quantity" value="@Model.BillItems[i].Quantity" />
                        <input type="hidden" name="BillItems[@i].Price" value="@Model.BillItems[i].Price" />
                        <input type="hidden" name="BillItems[@i].Amount" value="@Model.BillItems[i].Amount" />
                        
                        @if (Model.BillItems[i].DeliverySchedules != null)
                        {
                            @for (int j = 0; j < Model.BillItems[i].DeliverySchedules.Count; j++)
                            {
                                <input type="hidden" name="BillItems[@i].DeliverySchedules[@j].Id" value="@Model.BillItems[i].DeliverySchedules[j].Id" />
                                <input type="hidden" name="BillItems[@i].DeliverySchedules[@j].BillItemId" value="@Model.BillItems[i].DeliverySchedules[j].BillItemId" />
                                <input type="hidden" name="BillItems[@i].DeliverySchedules[@j].Date" value="@Model.BillItems[i].DeliverySchedules[j].Date.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="BillItems[@i].DeliverySchedules[@j].Quantity" value="@Model.BillItems[i].DeliverySchedules[j].Quantity" />
                            }
                        }
                    }
                }
                
                <input type="submit" value="Delete" class="btn btn-danger" /> |
                <a asp-action="Index">Back to List</a>
            </form>
        </div>
    </div>
</div>

<!-- Delivery Schedule Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delivery Schedule</h5>
                <button type="button" class="close" data-bs-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h6 id="itemNameDisplay"></h6>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 50%;">Delivery Date</th>
                                <th style="width: 50%; text-align: right;">Quantity</th>
                            </tr>
                        </thead>
                        <tbody id="scheduleTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Schedule button click
            $('.schedule-btn').click(function() {
                const itemIndex = $(this).data('item-index');
                const itemName = $(this).closest('tr').find('td:first div').text();
                
                $('#itemNameDisplay').text('Item: ' + itemName);
                $('#scheduleTableBody').empty();
                
                // Load delivery schedules for this item
                @if (Model.BillItems != null)
                {
                    @for (int i = 0; i < Model.BillItems.Count; i++)
                    {
                        <text>
                        if (itemIndex === @i) {
                            @if (Model.BillItems[i].DeliverySchedules != null && Model.BillItems[i].DeliverySchedules.Any())
                            {
                                @foreach (var schedule in Model.BillItems[i].DeliverySchedules)
                                {
                                    <text>
                                    $('#scheduleTableBody').append(`
                                        <tr>
                                            <td>@schedule.Date.ToString("yyyy-MM-dd")</td>
                                            <td style="text-align: right;">@schedule.Quantity</td>
                                        </tr>
                                    `);
                                    </text>
                                }
                            }
                            else
                            {
                                <text>
                                $('#scheduleTableBody').append(`
                                    <tr>
                                        <td colspan="2" class="text-center">No delivery schedules found</td>
                                    </tr>
                                `);
                                </text>
                            }
                        }
                        </text>
                    }
                }
                
                $('#scheduleModal').modal('show');
            });
        });
    </script>
}