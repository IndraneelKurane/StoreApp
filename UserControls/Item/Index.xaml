<UserControl x:Class="StoreApp.WPF.UserControls.Item.Index"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:StoreApp.WPF.UserControls.Item"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <StackPanel>
            <Button Content="Load Items" Command="{Binding LoadItemsCommand}" Margin="5" Width="100"/>
            <ListView ItemsSource="{Binding Items}" Margin="5">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="50"/>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                        <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}" Width="80"/>
                        <GridViewColumn Header="UnitId" DisplayMemberBinding="{Binding UnitId}" Width="80"/>
                        <GridViewColumn Header="LocationId" DisplayMemberBinding="{Binding LocationId}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>