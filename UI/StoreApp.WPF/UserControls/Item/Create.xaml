<UserControl x:Class="StoreApp.WPF.UserControls.Item.Create"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Create Item" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Item.Name}" Margin="5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Price:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Item.Price}" Margin="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Quantity:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Item.Quantity}" Margin="5"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Amount:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Item.Amount}" Margin="5"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Unit:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Units}" SelectedValue="{Binding Item.UnitId}" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5"/>

            <Label Grid.Row="5" Grid.Column="0" Content="Location:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Locations}" SelectedValue="{Binding Item.LocationId}" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Create" Command="{Binding CreateCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Back to List" Command="{Binding BackCommand}" Padding="10,5"/>
        </StackPanel>
    </Grid>
</UserControl>