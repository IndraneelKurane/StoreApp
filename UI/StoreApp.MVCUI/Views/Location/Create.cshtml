@model Location

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>LocationEntity</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocationRowId" class="control-label"></label>
                <select asp-for="LocationRowId" class ="form-control" asp-items="ViewBag.LocationRowNo"></select>
            </div>
            <div class="form-group">
                <label asp-for="RackNo" class="control-label"></label>
                <input asp-for="RackNo" class="form-control" />
                <span asp-validation-for="RackNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartedUsingOn" class="control-label"></label>
                <input asp-for="StartedUsingOn" class="form-control" />
                <span asp-validation-for="StartedUsingOn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
